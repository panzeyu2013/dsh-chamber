{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      // @dsh-chamber/dsh-chamber-client-core resolves through the workspace
      // node_modules link + its package.json exports (source targets): no paths
      // mirror is declared here on purpose (R4 P3; typecheck proves the link).
      // The four chamber client-plugin entries are checked by their own package
      // programs (their loose vendor faces collide when merged into one program);
      // the renderer consumes them only through this narrow registration face.
      // The module-loader contract is compiled by the client-web fork's own
      // program (real vendor sources + its deps); the root program consumes only
      // this program's loose face (0.1.7 moved FiberState/plugin-loader into it).
      "@deepseek-ai/dsh-client-modules/client": [
        "./packages/renderer/src/vendor-modules.d.ts"
      ],
      // alpha.3 P0: the official access-control client face the composite covers
      // first-screen (ui-session/ui-workspace inject `remoteAccess`). The vendor
      // package publishes lib-only faces this repo does not build; the root program
      // maps the one face the renderer imports to its pinned vendor source, exactly
      // like dsh-client-modules/client above.
      "@deepseek-ai/dsh-api-remote-access/client": [
        "./vendor/harness-packages/@deepseek-ai/dsh-api-remote-access/src/client/index.ts"
      ],
      // alpha.3: the account family is a deferred covered row again; the build-time
      // vendor patch gates its desktop onboarding overlay off (design 09 §3.5).
      "@deepseek-ai/dsh-client-ui-settings-account/client": [
        "./vendor/harness-packages/@deepseek-ai/dsh-client-ui-settings-account/src/client/index.ts"
      ],
      "@dsh-chamber/dsh-chamber-client-ui-sidebar/client": [
        "./packages/renderer/src/ambient/chamber-client-plugins.d.ts"
      ],
      "@dsh-chamber/dsh-chamber-client-ui-layout/client": [
        "./packages/renderer/src/ambient/chamber-client-plugins.d.ts"
      ],
      "@dsh-chamber/dsh-chamber-client-ui-git/client": [
        "./packages/renderer/src/ambient/chamber-client-plugins.d.ts"
      ],
      "@dsh-chamber/dsh-chamber-client-ui-open-in/client": [
        "./packages/renderer/src/ambient/chamber-client-plugins.d.ts"
      ]
    }
  },
  "include": [
    "packages/control-plane/src/**/*.ts",
    "packages/control-plane/test/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/cli/test/**/*.ts",
    "packages/renderer/src/**/*.ts",
    "packages/renderer/src/**/*.tsx",
    "packages/renderer/test/**/*.ts",
    "packages/desktop/*.ts",
    "packages/desktop/*.cts",
    "packages/desktop/test/**/*.ts",
    "packages/gateway/src/**/*.ts",
    "packages/gateway/test/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/vendor/**", "packages/desktop/scripts"]
}
