{
  "name": "dsh-chamber",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "dsh",
    "agent",
    "control-plane",
    "multi-host",
    "connection-manager"
  ],
  "scripts": {
    "preinstall": "node scripts/dev/ensure-harness-vendor.mjs",
    "postinstall": "node scripts/dev/ensure-electron.mjs",
    "dev:control-plane": "node packages/control-plane/src/standalone.ts",
    "build:renderer": "pnpm --filter @dsh-chamber/renderer run build",
    "build:host-graph": "pnpm --filter @dsh-chamber/dsh-host-client-graph run build",
    "build:host-git": "pnpm --filter @dsh-chamber/dsh-host-git-worktree run build",
    "build:host-packages": "pnpm run build:host-graph && pnpm run build:host-git",
    "build:dsh-runtime": "pnpm --filter @dsh-chamber/dsh-runtime run build",
    "build:gateway": "pnpm --filter @dsh-chamber/dsh-client-ui-mobile run build && pnpm run build:dsh-runtime && pnpm --filter @dsh-chamber/gateway run build",
    "build:desktop": "pnpm run build:host-packages && pnpm run build:renderer && pnpm --filter @dsh-chamber/desktop run build:control-plane && pnpm --filter @dsh-chamber/dsh-runtime run build && pnpm --filter @dsh-chamber/desktop run build:host-graph-package && pnpm --filter @dsh-chamber/desktop run build:preload && pnpm --filter @dsh-chamber/desktop run bundle:dsh",
    "dist:desktop": "pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist",
    "dist:desktop:mac": "pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist:mac",
    "dist:desktop:win": "pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist:win",
    "dist:desktop:linux": "pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist:linux",
    "acceptance:runtime:fake-registry": "node packages/desktop/scripts/runtime-fake-registry-acceptance.mjs",
    "acceptance:runtime:mac-packaged": "node packages/desktop/scripts/runtime-mac-packaged-smoke.mjs",
    "dev:desktop": "pnpm run build:dsh-runtime && pnpm --filter @dsh-chamber/desktop run dev",
    "dev:build": "pnpm run build:renderer && pnpm --filter @dsh-chamber/desktop run dev",
    "cli": "node packages/cli/src/index.ts",
    "smoke": "node packages/control-plane/test/smoke.test.ts",
    "verify:i18n": "node scripts/dev/verify-i18n.mjs",
    "verify:workflows": "node scripts/dev/verify-workflow-action-pins.mjs",
    "test:release-workflow": "node scripts/dev/release-workflow-policy.test.mjs",
    "gen:notices": "node scripts/dev/gen-third-party-notices.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:runtime": "tsc -p packages/dsh-runtime/tsconfig.json --noEmit",
    "typecheck:connections": "tsc -p packages/dsh-chamber-client-ui-settings-connections/tsconfig.json --noEmit",
    "typecheck:sidebar": "tsc -p packages/dsh-chamber-client-ui-sidebar/tsconfig.json --noEmit",
    "typecheck:layout": "tsc -p packages/dsh-chamber-client-ui-layout/tsconfig.json --noEmit",
    "typecheck:settings-bridge": "tsc -p packages/dsh-chamber-client-ui-settings-bridge/tsconfig.json --noEmit",
    "typecheck:client-web": "node scripts/dev/typecheck-client-web.mjs",
    "typecheck:connection": "node scripts/dev/typecheck-connection.mjs",
    "typecheck:host-graph": "pnpm --filter @dsh-chamber/dsh-host-client-graph run typecheck",
    "typecheck:git": "tsc -p packages/dsh-chamber-client-ui-git/tsconfig.json --noEmit",
    "typecheck:mobile": "tsc -p packages/dsh-chamber-client-ui-mobile/tsconfig.json --noEmit",
    "typecheck:host-git": "pnpm --filter @dsh-chamber/dsh-host-git-worktree run typecheck",
    "typecheck:open-in": "tsc -p packages/dsh-chamber-client-ui-open-in/tsconfig.json --noEmit",
    "test:control-plane": "pnpm --filter @dsh-chamber/control-plane run test",
    "typecheck:gateway": "tsc -p packages/gateway/tsconfig.json --noEmit",
    "test:desktop": "pnpm --filter @dsh-chamber/desktop run test",
    "test:runtime": "pnpm --filter @dsh-chamber/dsh-runtime run test",
    "test:sidebar": "pnpm --filter @dsh-chamber/dsh-client-ui-sidebar run test",
    "test:open-in": "pnpm --filter @dsh-chamber/dsh-client-ui-open-in run test",
    "test:layout": "pnpm --filter @dsh-chamber/dsh-client-ui-layout run test",
    "test:settings-bridge": "pnpm --filter @dsh-chamber/dsh-client-ui-settings-bridge run test",
    "test:connections": "pnpm --filter @dsh-chamber/dsh-client-ui-settings-connections run test",
    "test:client-web": "pnpm --filter @deepseek-ai/dsh-client-web run test",
    "test:git": "pnpm --filter @dsh-chamber/dsh-client-ui-git run test",
    "test:mobile": "pnpm --filter @dsh-chamber/dsh-client-ui-mobile run test",
    "test:host-git": "pnpm --filter @dsh-chamber/dsh-host-git-worktree run test",
    "test:renderer-shell": "pnpm --filter @dsh-chamber/renderer run test",
    "test:connection": "pnpm --filter @deepseek-ai/dsh-client-connection run test",
    "test:cli": "pnpm --filter @dsh-chamber/cli run test",
    "test:gateway": "pnpm --filter @dsh-chamber/gateway run test",
    "release:preflight": "node scripts/dev/release-preflight.mjs",
    "typecheck:api-gateway": "node scripts/dev/typecheck-api-gateway.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "node-pty": "^1.1.0",
    "typescript": "^7.0.2"
  }
}
