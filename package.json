{
  "name": "dsh-chamber",
  "version": "0.3.2-beta.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "dsh",
    "agent",
    "control-plane",
    "multi-host",
    "connection-manager"
  ],
  "scripts": {
    "preinstall": "node scripts/dev/ensure-harness-vendor.mjs",
    "postinstall": "node scripts/dev/ensure-electron.mjs",
    "dev:control-plane": "node packages/control-plane/src/standalone.ts",
    "build:renderer": "pnpm --filter @dsh-chamber/renderer run build",
    "build:host-graph": "pnpm --filter @dsh-chamber/dsh-chamber-seed-client-graph run build",
    "build:host-git": "pnpm --filter @dsh-chamber/dsh-chamber-seed-git-worktree run build",
    "build:host-archive-cleanup": "pnpm --filter @dsh-chamber/dsh-chamber-seed-archive-cleanup run build",
    "build:host-open-in": "pnpm --filter @dsh-chamber/dsh-chamber-seed-open-in run build",
    "build:host-packages": "pnpm run build:host-graph && pnpm run build:host-git && pnpm run build:host-archive-cleanup && pnpm run build:host-open-in",
    "build:mobile": "pnpm --filter @dsh-chamber/dsh-client-ui-mobile run build",
    "build:artifacts": "pnpm run build:dsh-runtime && pnpm run build:host-packages && pnpm run build:mobile",
    "ensure:artifacts": "node scripts/dev/ensure-artifacts.mjs",
    "build:sidecar": "pnpm run ensure:artifacts && pnpm --filter @dsh-chamber/desktop run build:sidecar",
    "build:swift-app": "pnpm run ensure:artifacts && node macos/scripts/build-swift-app.mjs",
    "build:dsh-runtime": "pnpm --filter @dsh-chamber/dsh-runtime run build",
    "build:gateway": "pnpm --filter @dsh-chamber/dsh-client-ui-mobile run build && pnpm run build:dsh-runtime && pnpm --filter @dsh-chamber/gateway run build",
    "build:desktop": "pnpm run ensure:artifacts && pnpm run build:host-packages && pnpm run build:renderer && pnpm --filter @dsh-chamber/desktop run build:control-plane && pnpm --filter @dsh-chamber/dsh-runtime run build && pnpm --filter @dsh-chamber/desktop run build:host-graph-package && pnpm --filter @dsh-chamber/desktop run build:preload && pnpm --filter @dsh-chamber/desktop run bundle:dsh",
    "dist:desktop": "pnpm run ensure:artifacts && pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist",
    "dist:desktop:mac": "pnpm run ensure:artifacts && pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist:mac",
    "dist:desktop:win": "pnpm run ensure:artifacts && pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist:win",
    "dist:desktop:linux": "pnpm run ensure:artifacts && pnpm run build:desktop && pnpm --filter @dsh-chamber/desktop run dist:linux",
    "acceptance:runtime:fake-registry": "node packages/desktop/scripts/runtime-fake-registry-acceptance.mjs",
    "acceptance:runtime:mac-packaged": "node packages/desktop/scripts/runtime-mac-packaged-smoke.mjs",
    "acceptance:gui": "node scripts/gui-acceptance/run.mjs",
    "dev:desktop": "pnpm run build:dsh-runtime && pnpm --filter @dsh-chamber/desktop run dev",
    "dev:build": "pnpm run build:renderer && pnpm --filter @dsh-chamber/desktop run dev",
    "cli": "node packages/cli/src/index.ts",
    "smoke": "node packages/control-plane/test/smoke.test.ts",
    "verify:i18n": "node scripts/gates/verify-i18n.mjs",
    "verify:styles": "node scripts/gates/verify-style-tokens.mjs",
    "verify:workflows": "node scripts/gates/verify-workflow-action-pins.mjs",
    "verify:workflow-yaml": "node scripts/gates/verify-workflow-yaml-scalars.mjs",
    "verify:test-wiring": "node scripts/gates/verify-test-wiring.mjs",
    "verify:shim-payload": "node scripts/gates/verify-shim-payload-shape.mjs",
    "verify:md-links": "node scripts/gates/verify-md-links.mjs",
    "verify:stream-state-equivalence": "node scripts/refactor/equivalence.mjs",
    "verify:stream-state-swift-parity": "node scripts/gates/verify-stream-state-swift-parity.mjs",
    "verify:ladder-table-parity": "node scripts/gates/verify-ladder-table-parity.mjs",
    "verify:registry": "node scripts/upstream/verify-registry.mjs",
    "verify:anchors": "node scripts/upstream/check-anchors.mjs",
    "check:static": "node scripts/gates/run-checks.mjs static",
    "check:tests": "node scripts/gates/run-checks.mjs tests",
    "check:typecheck": "node scripts/gates/run-checks.mjs typecheck",
    "check:full": "node scripts/gates/run-checks.mjs full",
    "test:scripts": "node scripts/gates/run-script-tests.mjs",
    "test:scripts:gates": "node scripts/gates/run-script-tests.mjs --group gates",
    "test:scripts:upstream": "node scripts/gates/run-script-tests.mjs --group upstream",
    "test:scripts:release": "node scripts/gates/run-script-tests.mjs --group release",
    "test:scripts:gui-acceptance": "node scripts/gates/run-script-tests.mjs --group gui-acceptance",
    "test:upgrade-tools": "node scripts/gates/run-script-tests.mjs --group upstream",
    "test:release-workflow": "node scripts/gates/run-script-tests.mjs --group release",
    "test:gui-acceptance": "node scripts/gates/run-script-tests.mjs --group gui-acceptance",
    "gen:notices": "node scripts/release/gen-third-party-notices.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:runtime": "tsc -p packages/dsh-runtime/tsconfig.json --noEmit",
    "typecheck:connections": "tsc -p packages/dsh-chamber-client-ui-settings-connections/tsconfig.json --noEmit",
    "typecheck:sidebar": "tsc -p packages/dsh-chamber-client-ui-sidebar/tsconfig.json --noEmit",
    "typecheck:layout": "tsc -p packages/dsh-chamber-client-ui-layout/tsconfig.json --noEmit",
    "typecheck:settings-bridge": "tsc -p packages/dsh-chamber-client-ui-settings-bridge/tsconfig.json --noEmit",
    "typecheck:client-web": "node scripts/dev/typecheck-client-web.mjs",
    "typecheck:connection": "node scripts/dev/typecheck-connection.mjs",
    "typecheck:host-graph": "pnpm --filter @dsh-chamber/dsh-chamber-seed-client-graph run typecheck",
    "typecheck:git": "tsc -p packages/dsh-chamber-client-ui-git/tsconfig.json --noEmit",
    "typecheck:mobile": "tsc -p packages/dsh-chamber-client-ui-mobile/tsconfig.json --noEmit",
    "typecheck:host-git": "pnpm --filter @dsh-chamber/dsh-chamber-seed-git-worktree run typecheck",
    "typecheck:host-archive-cleanup": "pnpm --filter @dsh-chamber/dsh-chamber-seed-archive-cleanup run typecheck",
    "typecheck:host-open-in": "pnpm --filter @dsh-chamber/dsh-chamber-seed-open-in run typecheck",
    "typecheck:open-in": "tsc -p packages/dsh-chamber-client-ui-open-in/tsconfig.json --noEmit",
    "test:api-gateway": "pnpm --filter @deepseek-ai/dsh-api-gateway run test",
    "test:stream-state": "pnpm --filter @dsh-chamber/dsh-stream-state run test",
    "test:control-plane": "pnpm --filter @dsh-chamber/control-plane run test",
    "typecheck:gateway": "tsc -p packages/gateway/tsconfig.json --noEmit",
    "test:desktop": "pnpm --filter @dsh-chamber/desktop run test",
    "test:macos": "pnpm --filter @dsh-chamber/desktop run test:macos",
    "test:swift": "node scripts/gates/run-swift-tests.mjs",
    "test:swift:release": "swift test --package-path macos -c release",
    "test:sidecar:compiled": "DSH_CHAMBER_SIDECAR_COMPILED=1 node scripts/gates/compiled-sidecar-smoke.mjs",
    "test:runtime": "pnpm --filter @dsh-chamber/dsh-runtime run test",
    "test:sidebar": "pnpm --filter @dsh-chamber/dsh-chamber-client-ui-sidebar run test",
    "test:open-in": "pnpm --filter @dsh-chamber/dsh-chamber-client-ui-open-in run test",
    "test:layout": "pnpm --filter @dsh-chamber/dsh-chamber-client-ui-layout run test",
    "test:settings-bridge": "pnpm --filter @dsh-chamber/dsh-chamber-client-ui-settings-bridge run test",
    "test:connections": "pnpm --filter @dsh-chamber/dsh-chamber-client-ui-settings-connections run test",
    "test:client-web": "pnpm --filter @deepseek-ai/dsh-client-web run test",
    "test:git": "pnpm --filter @dsh-chamber/dsh-chamber-client-ui-git run test",
    "test:mobile": "pnpm --filter @dsh-chamber/dsh-client-ui-mobile run test",
    "test:host-git": "pnpm --filter @dsh-chamber/dsh-chamber-seed-git-worktree run test",
    "test:host-archive-cleanup": "pnpm --filter @dsh-chamber/dsh-chamber-seed-archive-cleanup run test",
    "test:host-open-in": "pnpm --filter @dsh-chamber/dsh-chamber-seed-open-in run test",
    "test:renderer-shell": "pnpm --filter @dsh-chamber/renderer run test",
    "test:connection": "pnpm --filter @deepseek-ai/dsh-client-connection run test",
    "test:cli": "pnpm --filter @dsh-chamber/cli run test",
    "test:gateway": "pnpm --filter @dsh-chamber/gateway run test",
    "test:win32": "pnpm --filter @dsh-chamber/dsh-runtime run test:win32 && pnpm --filter @dsh-chamber/control-plane run test:win32 && pnpm --filter @dsh-chamber/desktop run test:win32 && pnpm --filter @dsh-chamber/renderer run test:win32 && pnpm --filter @dsh-chamber/dsh-chamber-client-ui-sidebar run test:win32",
    "release:preflight": "node scripts/release/release-preflight.mjs",
    "typecheck:api-gateway": "node scripts/dev/typecheck-api-gateway.mjs",
    "typecheck:stream-state": "tsc -p packages/dsh-stream-state/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "node-pty": "^1.1.0",
    "typescript": "^7.0.2"
  }
}
