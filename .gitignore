# Dependencies
node_modules/
.pnpm-store/
.pnp

# Build outputs
dist/
dist-ssr/
release/
build/
# scripts/release 是发布链源码，不是构建产物：上面的 release/ 规则会误伤它
# （2026-12 目录整理后暴露），必须显式反选回来。
!scripts/release/
!scripts/release/**
*.tgz
# 构建期生成；clean checkout 用 pnpm run build:artifacts 自举。dsh-runtime /
# 四个 seed / mobile 的 dist+lib 曾在全局 dist/ 规则下用反选行 tracked 进仓，
# 2026-12「产物移出 git」后不再反选（C8 仍按 src 重建-比对它们的新鲜度）。
packages/dsh-chamber-client-ui-mobile/lib/

# Local runtime state (control-plane data, audit log, dsh host state)
data/
# scripts/perf 测量数据（T0 场景表锚点）需要入库供前后对照（性能整改台账）
!scripts/perf/data/
*.pid
audit.log

# Local env
.env
.env.local
.npmrc

# Reference checkouts (symlinks to local repos, not part of this repo)
ref-dsh
ref-upstream

# Harness workspace symlinks (point into the pinned git submodule at
# vendor/harness-checkout — like ref-dsh/ref-upstream, the links themselves are
# never committed). The submodule gitlink IS committed, so it is excluded from
# the /vendor/* ignore below; the submodule working tree stays out of the parent
# repository's object store by gitlink semantics.
/vendor/*
!/vendor/harness-checkout/

# Bundled dsh copy inside the desktop package (produced by bundle:dsh, external
# repo content). Keep only its independently frozen dependency graph in Git;
# every installed/runtime artifact remains generated and ignored.
packages/desktop/vendor/*
!packages/desktop/vendor/dsh/
packages/desktop/vendor/dsh/*
!packages/desktop/vendor/dsh/pnpm-lock.yaml

# Dev-mode isolated app data (electron-dev.mjs --user-data-dir: own instance
# lock / state / registry / passwords, so dev coexists with a running packaged
# dsh-chamber instead of sharing its live userData)
packages/desktop/.dev-user-data/

# Renderer tooling caches and generated code
packages/renderer/.cache/
packages/renderer/src/generated/

# Agent memory
.graymatter/

# Local toolchain scratch (dev environment bootstrap: corepack cache / pnpm store / npm cache)
.tooling/

# Logs
logs
*.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
npm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db

# Temporary files
.tmp/
/tmp/
# Scratch workspace (upstream mirror + audit reports; never committed).
# .audit/ is this upgrade round's audit scratch (old-pin snapshots + npm cache);
# keep it out of Git like .analysis/ — delete it manually when its evidence is no longer needed.
.analysis/
.audit/

*.local
*.swp
# Gateway build output: host packages are copied in by scripts/build.mjs
# (the seed sources' dist artifacts are build-time generated (pnpm run build:artifacts)).
packages/gateway/host-packages/
