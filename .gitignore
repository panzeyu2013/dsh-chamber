# Dependencies
node_modules/
.pnpm-store/
.pnp

# Build outputs
dist/
dist-ssr/
release/
build/
*.tgz
# The chamber host packages ship committed esbuild artifacts (design 08/09):
# the control plane copies dist/index.js into profiles at seed time with zero
# build dependencies, so the artifacts must be tracked despite the global
# dist/ rule above (their build scripts still regenerate them on demand).
!packages/dsh-host-client-graph/dist/
!packages/dsh-host-client-graph/dist/index.js
!packages/dsh-chamber-host-git-worktree/dist/
!packages/dsh-chamber-host-git-worktree/dist/index.js
# The shared runtime core's dist/index.js is likewise a committed esbuild
# artifact: the desktop shims statically import the package main (dist) in
# dev AND packaged mode, so a clean checkout must carry it. Regenerate via
# `pnpm run build:dsh-runtime` after any packages/dsh-runtime/src change.
!packages/dsh-runtime/dist/
!packages/dsh-runtime/dist/index.js
# The mobile client plugin's host/client-half artifacts are the same
# committed-seed pattern (design 17 §18.3): the gateway build copies
# package.json + dist/index.js + lib/client.js(+.map) + lib/index.js into
# host-packages/ for the seed registry, so a clean checkout must carry
# them. Regenerate via `pnpm --filter @dsh-chamber/dsh-client-ui-mobile run build`.
!packages/dsh-chamber-client-ui-mobile/dist/
!packages/dsh-chamber-client-ui-mobile/dist/index.js

# Local runtime state (control-plane data, audit log, dsh host state)
data/
# scripts/perf 测量数据（T0 场景表锚点）需要入库供前后对照（性能整改台账）
!scripts/perf/data/
*.pid
audit.log

# Local env
.env
.env.local
.npmrc

# Reference checkouts (symlinks to local repos, not part of this repo)
ref-dsh
ref-upstream

# Harness workspace symlinks (point into the pinned git submodule at
# vendor/harness-checkout — like ref-dsh/ref-upstream, the links themselves are
# never committed). The submodule gitlink IS committed, so it is excluded from
# the /vendor/* ignore below; the submodule working tree stays out of the parent
# repository's object store by gitlink semantics.
/vendor/*
!/vendor/harness-checkout/

# Bundled dsh copy inside the desktop package (produced by bundle:dsh, external
# repo content). Keep only its independently frozen dependency graph in Git;
# every installed/runtime artifact remains generated and ignored.
packages/desktop/vendor/*
!packages/desktop/vendor/dsh/
packages/desktop/vendor/dsh/*
!packages/desktop/vendor/dsh/pnpm-lock.yaml

# Dev-mode isolated app data (electron-dev.mjs --user-data-dir: own instance
# lock / state / registry / passwords, so dev coexists with a running packaged
# dsh-chamber instead of sharing its live userData)
packages/desktop/.dev-user-data/

# Renderer tooling caches and generated code
packages/renderer/.cache/
packages/renderer/src/generated/

# Agent memory
.graymatter/

# Local toolchain scratch (dev environment bootstrap: corepack cache / pnpm store / npm cache)
.tooling/

# Logs
logs
*.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
npm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db

# Temporary files
.tmp/
/tmp/
*.local
*.swp
# Gateway build output: host packages are copied in by scripts/build.mjs
# (the seed sources' dist artifacts are committed in their own packages).
packages/gateway/host-packages/
