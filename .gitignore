# Dependencies
node_modules/
.pnpm-store/
.pnp

# Build outputs
dist/
dist-ssr/
release/
build/
*.tgz
# The chamber host-graph package ships a committed esbuild artifact (design 09
# §3.5): the control plane copies dist/index.js into profiles at seed time with
# zero build dependencies, so the artifact must be tracked despite the global
# dist/ rule above (its build script still regenerates it on demand).
!packages/dsh-host-client-graph/dist/
!packages/dsh-host-client-graph/dist/index.js

# Local runtime state (control-plane data, audit log, dsh host state)
data/
*.pid
audit.log

# Local env
.env
.env.local
.npmrc

# Reference checkouts (symlinks to local repos, not part of this repo)
ref-dsh
ref-upstream

# Harness workspace symlinks (point into the external dsh source checkout —
# like ref-dsh/ref-upstream, these local links are never committed)
vendor/

# Bundled dsh copy inside the desktop package (produced by bundle:dsh, external repo content)
packages/desktop/vendor/

# Dev-mode isolated app data (electron-dev.mjs --user-data-dir: own instance
# lock / state / registry / passwords, so dev coexists with a running packaged
# dsh-chamber instead of sharing its live userData)
packages/desktop/.dev-user-data/

# Renderer tooling caches and generated code
packages/renderer/.cache/
packages/renderer/src/generated/

# Agent memory
.graymatter/

# Logs
logs
*.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
npm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db

# Temporary files
.tmp/
/tmp/
*.local
*.swp
