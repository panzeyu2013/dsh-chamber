# Dependencies
node_modules/
.pnpm-store/
.pnp

# Build outputs
dist/
dist-ssr/
release/
build/
*.tgz
# The chamber host packages ship committed esbuild artifacts (design 08/09):
# the control plane copies dist/index.js into profiles at seed time with zero
# build dependencies, so the artifacts must be tracked despite the global
# dist/ rule above (their build scripts still regenerate them on demand).
!packages/dsh-host-client-graph/dist/
!packages/dsh-host-client-graph/dist/index.js
!packages/dsh-chamber-host-git-worktree/dist/
!packages/dsh-chamber-host-git-worktree/dist/index.js

# Local runtime state (control-plane data, audit log, dsh host state)
data/
*.pid
audit.log

# Local env
.env
.env.local
.npmrc

# Reference checkouts (symlinks to local repos, not part of this repo)
ref-dsh
ref-upstream

# Harness workspace symlinks (point into the external dsh source checkout —
# like ref-dsh/ref-upstream, these local links are never committed)
/vendor/

# Bundled dsh copy inside the desktop package (produced by bundle:dsh, external
# repo content). Keep only its independently frozen dependency graph in Git;
# every installed/runtime artifact remains generated and ignored.
packages/desktop/vendor/*
!packages/desktop/vendor/dsh/
packages/desktop/vendor/dsh/*
!packages/desktop/vendor/dsh/pnpm-lock.yaml

# Dev-mode isolated app data (electron-dev.mjs --user-data-dir: own instance
# lock / state / registry / passwords, so dev coexists with a running packaged
# dsh-chamber instead of sharing its live userData)
packages/desktop/.dev-user-data/

# Renderer tooling caches and generated code
packages/renderer/.cache/
packages/renderer/src/generated/

# Agent memory
.graymatter/

# Logs
logs
*.log
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
npm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db

# Temporary files
.tmp/
/tmp/
*.local
*.swp
