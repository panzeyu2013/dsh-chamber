<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dsh-chamber Swift 壳 Info.plist 模板（design 25 §5 E13 / W-24 输入）。

  W-24 消费方式（macos/scripts/build-swift-app.mjs 已落地）：读取本文件 →
  替换 __VERSION__（packages/desktop/package.json version）→ plutil -lint →
  写入 <App>.app/Contents/Info.plist → codesign（嵌套 node 先签、主 app 后签）。

  CFBundleURLTypes 是 E13 深链的注册面：Swift 侧 application(_:open:) 只有
  在 LaunchServices 注册了 dsh-chamber scheme 后才会被投递（冷/热启动同路，
  见 design 25 §4.5）。**共存注意（D2 未决）**：Electron 版同样注册
  dsh-chamber://（packages/desktop/package.json build.protocols）——同机
  双壳时 LaunchServices 对同 scheme 的归属由注册状态决定，需在 W-24/D2 决策
  记录中显式登记（本模板不改 scheme，保持与 Electron 版一致）。
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>DSHChamberPoc</string>
    <!-- W-24：build-swift-app 把 icon.icns 平移到 Contents/Resources；
         CFBundleIconFile 是 Dock/访达读取散装 .icns 的键（带扩展名），
         CFBundleIconName 是同一图标的 asset-catalog 名（本壳无 Assets.car，
         为与 Electron flavor 的 icon 命名对齐而保留，缺失时回落到
         CFBundleIconFile）。 -->
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <key>CFBundleIconName</key>
    <string>icon</string>
    <key>CFBundleIdentifier</key>
    <string>com.dshchamber.native</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>dsh-chamber-native</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUNDLE_VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 壳的 WKWebView 直连本机控制面 http://127.0.0.1:<port>（design 25 §3）：
         ATS 对 HTTP 缺省拒绝，必须显式放行 local networking。Electron flavor
         在 packages/desktop/package.json build.mac.extendInfo 携带同键。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- 应用内更新（Sparkle 2，2026-12 裁决 D-1 选 B）：feed 与 EdDSA 公钥由
         build-swift-app 在装配期替换（--sparkle-feed / --sparkle-public-key）。
         两键任一为空 = 更新不可用（dev、dry-run、未配置密钥的装配）——壳据此
         禁用「检查更新…」菜单项，绝不假装能更新。
         SUEnableAutomaticChecks 只在 feed 与公钥都配好时才写 true：ad-hoc/未发布
         装配启动即弹更新窗会与启动期窗口竞争（参考社区实现的做法）。
         SUScheduledCheckInterval 与 Electron 侧的 6h 周期同量级（Sparkle 默认 24h，
         这里显式写 21600 保持双 flavor 的检查节奏一致）。 -->
    <key>SUFeedURL</key>
    <string>__SPARKLE_FEED_URL__</string>
    <key>SUPublicEDKey</key>
    <string>__SPARKLE_PUBLIC_ED_KEY__</string>
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>21600</integer>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.dshchamber.native.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dsh-chamber</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
