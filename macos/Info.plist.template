<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dsh-chamber Swift 壳 Info.plist 模板（design 25 §5 E13 / W-24 输入）。

  W-24 消费方式（macos/scripts/build-swift-app.mjs 已落地）：读取本文件 →
  替换 __VERSION__（packages/desktop/package.json version）→ plutil -lint →
  写入 <App>.app/Contents/Info.plist → codesign（嵌套 node 先签、主 app 后签）。

  CFBundleURLTypes 是 E13 深链的注册面：Swift 侧 application(_:open:) 只有
  在 LaunchServices 注册了 dsh-chamber scheme 后才会被投递（冷/热启动同路，
  见 design 25 §4.5）。**共存（S-04，已 accepted）**：Electron 版同样注册
  dsh-chamber://（packages/desktop/package.json build.protocols）；两 flavor
  共用同一 <userData>/.dsh-chamber.lock，同机同一时刻只有一个能持锁运行，
  因此 scheme 归属不存在两个进程争抢的生产路径；被 LaunchServices 判给另一
  flavor 时的后果（链接进另一实例而它因锁退出）与登记见 deviations S-04。
  新 scheme 会破坏既有深链生产者，故不新增；本模板不改 scheme，保持与
  Electron 版一致。
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- S2（本地化）：CFBundleLocalizations = **进程偏好集合的声明面**。
         它不是「翻译清单」而是 Bundle/系统框架在解析 preferredLocalizations 时
         允许的本地化全集；盘上的 .lproj 本身也参与 Foundation 的
         localizations/preferredLocalizations 解析，两者叠加会让 localizations
         出现重复项（无功能影响）。真正的文案来自随包的
         Contents/Resources/{en,zh-Hans}.lproj/Localizable.strings——装配腿
         build-swift-app.mjs 在拷贝后断言两者存在，缺席即 fail。
         装配腿机械校验的三处同源：build-swift-app.mjs 的 LOCALIZATIONS、本键
         （dry-run 逐字比对）、Package.swift 两个 .process("…lproj") 的产物
         （装配期断言 SwiftPM 资源包内两个 .lproj 都在）。壳内
         ShellLanguagePolicy/NativeText 写死的 en / zh-Hans 字面量（后者是 Apple
         的脚本拼写，不用 zh_CN/zh-CN）没有机械比对，由
         NativeTextLanguageOverrideTests 的解析成功隐式锁定。
         CFBundleDevelopmentRegion 保持 en 不变：它只承担缺省回退语言。 -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
    </array>
    <key>CFBundleExecutable</key>
    <string>dsh-chamber</string>
    <!-- W-24：build-swift-app 把 icon.icns 平移到 Contents/Resources；
         CFBundleIconFile 是 Dock/访达读取散装 .icns 的键（带扩展名），
         CFBundleIconName 是同一图标的 asset-catalog 名（本壳无 Assets.car，
         为与 Electron flavor 的 icon 命名对齐而保留，缺失时回落到
         CFBundleIconFile）。 -->
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <key>CFBundleIconName</key>
    <string>icon</string>
    <key>CFBundleIdentifier</key>
    <string>com.dshchamber.native</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>dsh-chamber</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <!-- S-23：build-swift-app 注入的 CFBundleVersion 是 Sparkle 的比较键
         （只含点分十进制整数，4 段）。稳定版 X.Y.Z → X.Y.Z.999999999
         （第 4 段 = final 标记，恒大于同 base 的 beta）；beta 版
         X.Y.Z-beta.N → X.Y.Z.N（第 4 段 = beta 序号，随 N 单调递增）。
         这样 beta.N 能看到 beta.N+1 与 final，final 也不会被同 base 的
         beta 盖住（去掉 -beta.N 两者会相等）。CFBundleShortVersionString
         保留完整发布版本字符串（含 -beta.N）用于展示。 -->
    <key>CFBundleVersion</key>
    <string>__BUNDLE_VERSION__</string>
    <!-- 最低系统下限 = macOS 14.4，且这里承担**精确**下限（SwiftPM 的 .macOS 只能写
         major：Package.swift 写 .macOS(.v14)）。为什么是 14.4：原生壳用 OS WebKit，
         出货 bundle 在审批决策、用户提问/计划评审、PDF 预览构造路径直接调用
         Promise.withResolvers（A3-1），该 API 自 Safari 17.4 / macOS 14.4 才存在；
         13.x 与 14.0–14.3 会在构造期 TypeError。Electron 自带 V8 不受影响，但同一
         支持矩阵只有一个下限（不做 polyfill，2026-12 用户裁决）。三处一致性由
         scripts/release/release-workflow-policy.test.mjs 钉住。 -->
    <key>LSMinimumSystemVersion</key>
    <string>14.4</string>
    <!-- S-46：标准 About 面板（orderFrontStandardAboutPanel）的版权行。
         Electron 侧未显式配 copyright，app-builder-lib 以
         「Copyright © <构建年> <productName>」生成（appInfo.js:129-135），
         即 Copyright © 2026 dsh-chamber；本模板是静态装配输入，年份取加入
         时的构建年（跨年后随装配更新，与 Electron 的构建期生成同义）。 -->
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 dsh-chamber</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 壳的 WKWebView 直连本机控制面（design 25 §3）：打包态 origin 是
         http://localhost:<port>（AppDelegate.controlPlaneHost）。ATS 对 HTTP
         缺省拒绝，必须显式放行。S-45（2026-12 实机修正）：放行的关键是**正确
         键名** NSExceptionAllowsInsecureHTTPLoads——旧键 NSTemporaryException...
         在 macOS 26 实测不生效（127.0.0.1 + 旧键 → WebKit 报 ATS
         NSURLError -1022；仅把键名改正确即加载成功）。两个例外域
         （localhost + 127.0.0.1）都写、都用正确键名；打包态导航 origin 用
         localhost（ATS 文档的例外形态是 DNS 域名，走域名匹配路径，不赌 IP
         字面量键在其它系统版本的采纳）。缺例外时首载会落到失败说明页（S-27）。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <false/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
            <key>127.0.0.1</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <false/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
    <!-- 应用内更新（Sparkle 2，2026-12 裁决 D-1 选 B）：feed 与 EdDSA 公钥由
         build-swift-app 在装配期替换（--sparkle-feed / --sparkle-public-key）。
         两键任一为空 = 更新不可用（dev、dry-run、未配置密钥的装配）——壳据此
         禁用「检查更新…」菜单项，绝不假装能更新。
         SUEnableAutomaticChecks 是模板常量 true（D9 修正：renderInfoPlist 只替换
         __VERSION__/__BUNDLE_VERSION__/__SPARKLE_*，**不写**该键）——自动检查开：
         原生腿启动即检、之后每 SUScheduledCheckInterval=600s（10min）一次，与
         Electron 侧 update-schedule.ts 的 600s 基准对齐（Sparkle 默认 24h，这里显式
         写 600 保持双 flavor 同节奏；Electron 侧另有 ±20% 抖动与失败退避）。scheduled 更新的弹窗在代码里抑制
         （SPUStandardUserDriverDelegate 把展示权收回壳，见 AppUpdater.swift），
         展示面是设置页（nativeUpdatePhase）；用户手动的「检查更新…」仍走 Sparkle
         标准窗口——这两条都是代码行为，模板只声明自动检查与检查间隔。 -->
    <key>SUFeedURL</key>
    <string>__SPARKLE_FEED_URL__</string>
    <key>SUPublicEDKey</key>
    <string>__SPARKLE_PUBLIC_ED_KEY__</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>600</integer>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.dshchamber.native.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dsh-chamber</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
