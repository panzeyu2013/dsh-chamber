{
  "name": "@dsh-chamber/dsh-chamber-client-ui-settings-connections",
  "description": "Chamber connections settings section plugin (design 05 §5): local instance card (health / connections row / host logs) + remote host management (registry CRUD, connect/disconnect, on-demand systemd control, ring-buffer logs)",
  "version": "0.4.0-beta.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panzeyu2013/dsh-chamber.git",
    "directory": "packages/dsh-chamber-client-ui-settings-connections"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./section": "./src/client/ConnectionsSection.tsx",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@dsh-chamber/dsh-chamber-client-core": "workspace:^",
    "@dsh-chamber/renderer": "workspace:^",
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@dsh-chamber/dsh-chamber-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@dsh-chamber/dsh-chamber-client-ui-sidebar": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node ./scripts/test.mjs"
  }
}
