{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // P4-4: the `@dsh-chamber/dsh-client-ui-sidebar/shared` local paths mirror
    // was deleted — the specifier now resolves through the ROOT tsconfig
    // paths to the REAL sidebar shared source (src/shared/index.ts) and the
    // ambient mirror file src/ambient/sidebar-shared.d.ts is gone. The shared
    // sources are compiled into this program as import dependencies, so the
    // compile root spans the repo root (layout/git precedent); tsc only
    // type-checks here (root noEmit + tsdown bundles); outDir is a mirror.
    "rootDir": "../..",
    "outDir": "lib/types"
  },
  "include": [
    "src",
    "test"
  ]
}
