{
  "name": "@dsh-chamber/dsh-client-ui-open-in",
  "description": "Chamber-bundled open-in client plugin: open the current source's workspace in Finder (local) or VS Code (local/remote SSH), design 16 + open-in extension",
  "version": "0.2.0-beta.6",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./src/client/index.ts",
    "./shared": "./src/shared/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/capabilities.ts && node test/coordinator.ts && node test/menu-navigation.ts && node test/open-in-gates.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.0.0"
  }
}
