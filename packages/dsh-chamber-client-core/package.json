    "./session-row-window": "./src/session-row-window.ts",
    "./settings-shell": "./src/settings-shell.ts",
    "./subagent-lineage": "./src/subagent-lineage.ts",
    "./todo-attention": "./src/todo-attention.ts",
    "./todo-prefs": "./src/todo-prefs.ts",
    "./view-prefs": "./src/view-prefs.ts",
    "./wire-common": "./src/wire-common.ts",
    "./workspace-drag-order": "./src/workspace-drag-order.ts",
    "./workspace-git-flags": "./src/workspace-git-flags.ts",
    "./workspace-mutations": "./src/workspace-mutations.ts",
    "./runtime-management": "./src/runtime-management.ts",
    "./svg-resource-scope": "./src/svg-resource-scope.ts",
    "./package.json": "./package.json"
