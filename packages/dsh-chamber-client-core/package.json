    "./derive": "./src/derive.ts",
    "./hover-intent": "./src/hover-intent.ts",
    "./instance-api": "./src/instance-api.ts",
    "./managed-runtime": "./src/managed-runtime.ts",
    "./open-intent": "./src/open-intent.ts",
    "./open-outcome": "./src/open-outcome.ts",
    "./pending-click": "./src/pending-click.ts",
    "./plugin-graph-classify": "./src/plugin-graph-classify.ts",
    "./plugin-manifest": "./src/plugin-manifest.ts",
    "./plugin-row": "./src/plugin-row.ts",
    "./prewarm-intent": "./src/prewarm-intent.ts",
    "./purged-tracker": "./src/purged-tracker.ts",
    "./search-state": "./src/search-state.ts",
    "./session-create-ledger": "./src/session-create-ledger.ts",
