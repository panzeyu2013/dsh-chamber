{
  "name": "@dsh-chamber/gateway",
  "version": "0.3.1",
  "dshAnchorVersion": "0.1.5-rc.2",
  "description": "Server-side access gateway for dsh-chamber: exposes a managed dsh as an authenticated URL (design 17)",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "gateway": "./dist/cli.js",
    "dsh-chamber-gateway": "./dist/cli.js"
  },
  "files": [
    "dist",
    "host-packages",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./scripts/test.mjs",
    "prepack": "pnpm --filter @dsh-chamber/dsh-client-ui-mobile run build && pnpm run build"
  },
  "license": "MIT",
  "dependencies": {
    "pnpm": "11.21.0"
  },
  "devDependencies": {
    "@dsh-chamber/control-plane": "workspace:^",
    "@dsh-chamber/dsh-runtime": "workspace:^",
    "esbuild": "^0.28.2"
  }
}
