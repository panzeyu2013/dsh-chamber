{
  "name": "@dsh-chamber/control-plane",
  "version": "0.4.0-beta.3",
  "description": "Control plane for dsh-chamber: manages a local dsh host (web profile spawn/health/logs), per-instance reverse proxy and static frontend serving",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "dsh-chamber-control-plane": "./src/standalone.ts"
  },
  "scripts": {
    "test": "node ../../scripts/dev/ensure-artifacts.mjs && node ./scripts/test.mjs",
    "test:win32": "node ../../scripts/dev/ensure-artifacts.mjs && node ./scripts/test.mjs --win32"
  },
  "license": "MIT",
  "dependencies": {
    "@dsh-chamber/dsh-chamber-wire": "workspace:^",
    "ws": "^8.18.0"
  }
}
