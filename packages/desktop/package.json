{
  "name": "@dsh-chamber/desktop",
  "version": "0.2.0-beta.6",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "dev": "node ./scripts/electron-dev.mjs",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "build:control-plane": "node scripts/build-control-plane.mjs",
    "build:host-graph-package": "node scripts/build-host-graph-package.mjs",
    "build:preload": "node scripts/build-preload.mjs",
    "dist": "node ./node_modules/electron-builder/cli.js",
    "dist:mac": "node ./node_modules/electron-builder/cli.js --mac",
    "dist:win": "node ./node_modules/electron-builder/cli.js --win --x64",
    "test": "node transport-manager.test.ts && node transport-target.test.ts && node credential-binding.test.ts && node connection-save.test.ts && node ssh-provider.test.ts && node ssh-config.test.ts && node gateway-provider.test.ts && node gateway-ipc-shared.test.ts && node gateway-sync-registry.test.ts && node gateway-session.test.ts && node audit-log.test.ts && node runtime-lockstep.test.ts && node renderer-trust.test.ts && node plugin-sync.test.ts && node plugin-tarball.test.ts && node cross-package-contract.test.ts && node ipc-surface-mirror.test.ts && node chamber-settings.test.ts && node notifications.test.ts && node deep-link.test.ts && node open-in.test.ts && node updater.test.ts && node scripts/bundle-swap.test.mjs && node scripts/after-pack-adhoc-sign.test.mjs && node dsh-runtime-controller.test.ts && node apply-now-gate.test.ts && node ssh-apply-rows.test.ts && node ssh-plugin-journal.test.ts"
  },
  "dependencies": {
    "@dsh-chamber/control-plane": "workspace:^",
    "@dsh-chamber/dsh-runtime": "workspace:^",
    "electron-updater": "^6.8.9",
    "pnpm": "11.21.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.2.1",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dshchamber.desktop",
    "productName": "dsh-chamber",
    "protocols": [
      {
        "name": "dsh-chamber",
        "schemes": [
          "dsh-chamber"
        ]
      }
    ],
    "afterPack": "./scripts/after-pack-adhoc-sign.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.ts",
      "*.cts",
      "*.mjs",
      "!*.test.ts",
      "dist/**/*",
      "package.json",
      "!node_modules/@dsh-chamber/control-plane/**",
      "!dist/.vite/**",
      "!vendor/**",
      "!scripts/**",
      "!README.md"
    ],
    "asarUnpack": [
      "sanitize-error.ts",
      "registry-url.ts",
      "registry-integrity.ts",
      "registry-metadata.ts",
      "version-safety.ts",
      "dsh-runtime-updater.ts",
      "runtime-installer.ts",
      "dsh-runtime-controller.ts",
      "dsh-runtime-store.ts",
      "runtime-startup.ts",
      "runtime-probes.ts",
      "restart-exhausted-rollback.ts",
      "runtime-operation-fence.ts",
      "runtime-metadata-recovery.ts",
      "activation-gate.ts",
      "override-lifecycle.ts",
      "snapshot-store.ts",
      "apply-phase.ts",
      "runtime-state-machine.ts",
      "known-good-monitor.ts",
      "allow-builds.mjs",
      "prune-runtime.mjs"
    ],
    "extraResources": [
      {
        "from": "vendor/dsh",
        "to": "vendor/dsh",
        "filter": [
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "from": "vendor/dsh/node_modules",
        "to": "vendor/dsh/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/pnpm",
        "to": "pnpm",
        "filter": [
          "package.json",
          "bin/pnpm.cjs",
          "bin/pnpm.mjs",
          "dist/**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "notarize": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            },
            "localhost": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "differentialPackage": false,
      "useZip": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "panzeyu2013",
        "repo": "dsh-chamber"
      }
    ],
    "linux": {
      "icon": "resources/icons",
      "target": [
        "dir"
      ]
    },
    "beforePack": "./scripts/before-pack.mjs"
  }
}
