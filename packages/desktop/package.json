{
  "name": "@dsh-chamber/desktop",
  "version": "0.1.5",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "dev": "node ./scripts/electron-dev.mjs",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "build:control-plane": "node scripts/build-control-plane.mjs",
    "build:host-graph-package": "node scripts/build-host-graph-package.mjs",
    "build:preload": "node scripts/build-preload.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@dsh-chamber/control-plane": "workspace:^",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dshchamber.desktop",
    "productName": "dsh-chamber",
    "protocols": [
      {
        "name": "dsh-chamber",
        "schemes": [
          "dsh-chamber"
        ]
      }
    ],
    "afterPack": "./scripts/after-pack-adhoc-sign.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.ts",
      "preload.cts",
      "updater.ts",
      "chamber-settings.ts",
      "transport-provider.ts",
      "transport-manager.ts",
      "ssh-provider.ts",
      "ssh-config.ts",
      "renderer-trust.ts",
      "plugin-sync.ts",
      "deep-link.ts",
      "dist/**/*",
      "package.json",
      "!node_modules/@dsh-chamber/control-plane/**",
      "!vendor/**",
      "!scripts/**",
      "!README.md"
    ],
    "extraResources": [
      {
        "from": "vendor/dsh",
        "to": "vendor/dsh",
        "filter": [
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "from": "vendor/dsh/node_modules",
        "to": "vendor/dsh/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "notarize": true,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            },
            "localhost": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "differentialPackage": false,
      "useZip": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "panzeyu2013",
        "repo": "dsh-chamber"
      }
    ],
    "linux": {
      "icon": "resources/icons",
      "target": [
        "dir"
      ]
    }
  }
}
