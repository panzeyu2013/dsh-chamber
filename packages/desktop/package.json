{
  "name": "@dsh-chamber/desktop",
  "version": "0.4.0-beta.1",
  "type": "module",
  "main": "main.ts",
  "scripts": {
    "dev": "node ./scripts/electron-dev.mjs",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "build:control-plane": "node scripts/build-control-plane.mjs",
    "build:host-graph-package": "node scripts/build-host-graph-package.mjs",
    "build:preload": "node scripts/build-preload.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "prepare:python-payload": "node scripts/prepare-python-payload.mjs",
    "prepare:python-payload:dry-run": "node scripts/prepare-python-payload.mjs --dry-run",
    "verify:python-payload": "node scripts/prepare-python-payload.mjs --verify resources/primary-runtime",
    "dist": "node ./node_modules/electron-builder/cli.js",
    "dist:mac": "node ./node_modules/electron-builder/cli.js --mac",
    "dist:win": "node ./node_modules/electron-builder/cli.js --win --x64",
    "dist:linux": "node ./node_modules/electron-builder/cli.js --linux --x64",
    "test": "node ../../scripts/dev/ensure-artifacts.mjs && node ./scripts/test.mjs",
    "test:macos": "node ../../scripts/dev/ensure-artifacts.mjs && node ./scripts/test.mjs --macos",
    "test:win32": "node ../../scripts/dev/ensure-artifacts.mjs && node ./scripts/test.mjs --win32"
  },
  "dependencies": {
    "@dsh-chamber/control-plane": "workspace:^",
    "@dsh-chamber/dsh-runtime": "workspace:^",
    "electron-updater": "^6.8.9",
    "pnpm": "11.21.0"
  },
  "devDependencies": {
    "@dsh-chamber/dsh-chamber-client-core": "workspace:^",
    "@electron/asar": "^3.2.1",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dshchamber.desktop",
    "productName": "dsh-chamber-electron",
    "protocols": [
      {
        "name": "dsh-chamber-electron",
        "schemes": [
          "dsh-chamber"
        ]
      }
    ],
    "afterPack": "./scripts/after-pack-adhoc-sign.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.ts",
      "*.cts",
      "*.mjs",
      "!*.test.ts",
      "!sidecar-stub.ts",
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/@dsh-chamber/control-plane/**",
      "!dist/.vite/**",
      "!vendor/**",
      "!scripts/**",
      "!README.md"
    ],
    "asarUnpack": [
      "sanitize-error.ts",
      "dsh-runtime-controller.ts"
    ],
    "extraResources": [
      {
        "from": "vendor/dsh",
        "to": "vendor/dsh",
        "filter": [
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "from": "vendor/dsh/node_modules",
        "to": "vendor/dsh/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/pnpm",
        "to": "pnpm",
        "filter": [
          "package.json",
          "bin/pnpm.cjs",
          "bin/pnpm.mjs",
          "dist/**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/primary-runtime",
        "to": "primary-runtime"
      }
    ],
    "electronFuses": {
      "runAsNode": true
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "notarize": true,
      "minimumSystemVersion": "14.4",
      "electronLanguages": [
        "en",
        "zh_CN"
      ],
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            },
            "localhost": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "differentialPackage": false,
      "useZip": false,
      "include": "scripts/nsis-uninstall-cleanup.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "panzeyu2013",
        "repo": "dsh-chamber"
      }
    ],
    "linux": {
      "icon": "resources/icons",
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "dsh-chamber-electron",
      "desktop": {
        "entry": {
          "Name": "dsh-chamber",
          "Comment": "dsh-chamber desktop connection manager",
          "Icon": "dsh-chamber",
          "StartupWMClass": "dsh-chamber"
        }
      }
    },
    "beforePack": "./scripts/before-pack.mjs"
  }
}
