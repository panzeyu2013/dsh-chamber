{
  "name": "@dsh-chamber/dsh-chamber-client-ui-git",
  "description": "Chamber-bundled Git worktree client plugin: per-instance topology and safe create/remove lifecycle in the official sidebar shell",
  "version": "0.4.0-beta.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node ./scripts/test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@dsh-chamber/dsh-chamber-client-core": "workspace:^",
    "@dsh-chamber/dsh-chamber-client-ui-sidebar": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.0.0"
  }
}
