{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The layout-store tests run the REAL vendor column geometry (columns.ts)
    // as the injected env face, so the compile root must span the repo-level
    // vendor source tree, not just this package. tsc only type-checks here
    // (root noEmit + tsdown bundles); outDir is a declaration mirror.
    // The `@dsh-chamber/dsh-chamber-client-core` specifier resolves through the
    // workspace node_modules link + the core package exports (source targets);
    // no ambient mirror file exists.
    "rootDir": "../..",
    "outDir": "lib/types"
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "node_modules",
    "**/vendor/**",
    "../dsh-chamber-client-core"
  ]
}
