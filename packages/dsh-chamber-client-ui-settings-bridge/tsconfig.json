{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The `@dsh-chamber/dsh-chamber-client-core` specifier maps to the REAL core
    // source `.` face below. NOTE: this package keeps its OWN `paths`
    // (connections-section below), and a child tsconfig `paths` REPLACES the
    // inherited root paths — the mapping is required because the shared
    // gateway-runtime fixture under scripts/dev/test-support resolves the bare
    // specifier from OUTSIDE this package, where the node_modules workspace link
    // (peer dependency) cannot reach. The core sources are compiled into this
    // program as import dependencies, so the compile root spans the repo root
    // (layout/git/connections precedent); tsc only type-checks here (root
    // noEmit + tsdown bundles); outDir is a mirror. The connections-section
    // ambient mapping is UNRELATED and stays.
    //
    // The renderer's `src/client/bindings.tsx`
    // deep specifier is mapped to its own ambient face too. Deep `./src/*`
    // specifiers otherwise resolve to the REAL vendor source, and that module
    // reads host/binding types (`ui-slots/src/renderer.ts`) the chamber's loose
    // `ui-slots` ambient mirror deliberately does not carry — mapping it keeps
    // the consumed surface explicit (one factory) instead of mirroring the
    // renderer's internal type web; vite still resolves the real TSX at build
    // time (packages/renderer/vite.config.mjs `deepseekSource`).
    "rootDir": "../..",
    "outDir": "lib/types",
    "paths": {
      "@dsh-chamber/dsh-chamber-client-ui-settings-connections/section": [
        "./src/ambient/connections-section.d.ts"
      ],
      // The shared gateway-runtime fixture lives under scripts/dev/test-support
      // (one implementation for the settings suites), outside this package, so
      // the node_modules workspace link the comment above relies on cannot
      // resolve the specifier from there. Map it at the REAL core source, so
      // no mirror face comes back; the in-package consumers keep using the link.
      "@dsh-chamber/dsh-chamber-client-core": [
        "../../packages/dsh-chamber-client-core/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/src/client/bindings.tsx": [
        "./src/ambient/renderer-bindings.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "node_modules",
    "**/vendor/**",
    "../dsh-chamber-client-core"
  ]
}
