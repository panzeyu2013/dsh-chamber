{
  "name": "@dsh-chamber/dsh-client-ui-settings-bridge",
  "description": "Chamber settings bridge section plugin: a server selector plus the target instance's official Settings content, rendered through a per-instance child cordis context (fake connection + official settings plugin subset). Config facts stay on the target host — the bridge only proxies the existing settings/credentials/llm RPC surface.",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panzeyu2013/dsh-chamber.git",
    "directory": "packages/dsh-chamber-client-ui-settings-bridge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./src/client/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-agent-preset": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-models": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-plugin-inventory": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@dsh-chamber/dsh-client-ui-sidebar": "workspace:^",
    "@dsh-chamber/dsh-client-ui-settings-connections": "workspace:^",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-agent-preset": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-models": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-plugin-inventory": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:^",
    "@dsh-chamber/dsh-client-ui-sidebar": "workspace:^",
    "@dsh-chamber/dsh-client-ui-settings-connections": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "test": "node test/busy-enter-policy.test.ts && node test/permission-controller.test.ts && node test/gateway-runtime-api.test.ts && node test/mount-retry.test.ts && node test/nav-active.test.ts && node test/server-selector.test.ts && node test/update-gate.test.ts && node test/runtime-management.test.ts && node test/settings-store.test.ts && node test/notifications-settings.test.ts && node test/session-todo-settings.test.ts"
  }
}
